          </ui:ReadPDFText>
          <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ---------- 1) Numero da apolice ----------&#xA;Dim m = System.Text.RegularExpressions.Regex.Match(texto, &quot;N\s*[º°]\s*Ap[óo]lice\s*Seguro\s*Garantia\s*([\d\-]+)&quot;)&#xA;If m.Success Then dados(&quot;NumeroApolice&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;' ---------- 2) Controle interno ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;Controle\s*Interno\s*\(C[óo]digo\s*Controle\)\s*(\d+)&quot;)&#xA;If m.Success Then dados(&quot;ControleInterno&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;' ---------- 3) Data de emissao ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;Data\s*de\s*emiss[ãa]o\s*(\d{2}/\d{2}/\d{4})&quot;)&#xA;If m.Success Then dados(&quot;DataEmissao&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;' ---------- 4) Vigencias (mesma linha) ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;In[íi]cio\s*T[ée]rmino\s*[\r\n\s]+(\d{2}/\d{2}/\d{4})\s*(\d{2}/\d{2}/\d{4})&quot;)&#xA;If m.Success Then&#xA;    dados(&quot;InicioVigencia&quot;) = m.Groups(1).Value.Trim()&#xA;    dados(&quot;TerminoVigencia&quot;) = m.Groups(2).Value.Trim()&#xA;End If&#xA;&#xA;' ---------- 5) Limite Maximo Garantido (IS) ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;Limite\s*M[áa]ximo\s*Garantido\s*\(L\.?\s*M\.?\s*G\)\s*R\$\s*([\d.,]+)&quot;)&#xA;If m.Success Then dados(&quot;LimiteMaximoGarantido&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;' ---------- 6) Premio liquido / IOF / Total ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;Pr[êe]mio\s*L[íi]quido[^\r\n]*R\$\s*([\d.,]+)&quot;)&#xA;If m.Success Then dados(&quot;PremioLiquido&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;I\.?\s*O\.?\s*F\s*R\$\s*([\d.,]+)&quot;)&#xA;If m.Success Then dados(&quot;IOF&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;Pr[êe]mio\s*Total\s*R\$\s*([\d.,]+)&quot;)&#xA;If m.Success Then dados(&quot;PremioTotal&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;' ---------- 7) Edital ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;(?&lt;=Edital\s+DE\s+)PRE\s*G[ÃA]O\s+ELETR[ÔO]NICO\s+SRP\s+N[º°]\s*[\d/]+-?[A-Z]*&quot;)&#xA;If m.Success Then dados(&quot;Edital&quot;) = m.Value.Trim()&#xA;&#xA;' ---------- 8) Processo administrativo ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;PROCESSO\s+ADMINISTRATIVO\s*N[º°]?\s*([\d/]+)&quot;)&#xA;If m.Success Then dados(&quot;Processo&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;' ---------- 9) Segurado (CNPJ + nome) ----------&#xA;' O CNPJ do segurado vem SEMPRE depois de &quot;CPF ou CNPJ&quot;&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;CPF\s*ou\s*CNPJ\s*n\s*[ªº]?\s*:?\s*([\d./\-]{14,20})&quot;)&#xA;If m.Success Then dados(&quot;CnpjSegurado&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;' O nome do segurado e a linha imediatamente ACIMA do &quot;CPF ou CNPJ&quot;&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;([^\r\n]{5,120})\r?\n\s*CPF\s*ou\s*CNPJ&quot;)&#xA;If m.Success Then dados(&quot;NomeSegurado&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;' ---------- 10) Tomador (CNPJ + nome) ----------&#xA;' O bloco do Tomador vem depois da palavra &quot;Tomador&quot; e tem seu próprio &quot;CPF ou CNPJ&quot;&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;Tomador[\s\S]{0,600}?CPF\s*ou\s*CNPJ\s*n\s*[ªº]?\s*:?\s*([\d./\-]{14,20})&quot;)&#xA;If m.Success Then dados(&quot;CnpjTomador&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;Tomador\s*\r?\n\s*([^\r\n]{5,120})&quot;)&#xA;If m.Success Then dados(&quot;NomeTomador&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;' ---------- 11) Modalidade / Ramo ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;Modalidade\s+([A-ZÀ-Ú][^\r\n]{2,60})&quot;)&#xA;If m.Success Then dados(&quot;Modalidade&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;Ramo\s*(\d{4})\s*-\s*([^\r\n]{3,60})&quot;)&#xA;If m.Success Then&#xA;    dados(&quot;RamoCodigo&quot;) = m.Groups(1).Value.Trim()&#xA;    dados(&quot;RamoDescricao&quot;) = m.Groups(2).Value.Trim()&#xA;End If&#xA;&#xA;' ---------- 12) Seguradora ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;(JUNTO\s+SEGUROS\s*S\.?/?A?\.?)&quot;)&#xA;If m.Success Then dados(&quot;Seguradora&quot;) = m.Groups(1).Value.Trim()&#xA;&#xA;' ---------- 13) Parcela: numero, vencimento e valor ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;\n\s*(\d{1,2})\s+(\d{2}/\d{2}/\d{4})\s+(\d+)\s+R\$\s*([\d.,]+)&quot;)&#xA;If m.Success Then&#xA;    dados(&quot;ParcelaNumero&quot;) = m.Groups(1).Value.Trim()&#xA;    dados(&quot;ParcelaVencimento&quot;) = m.Groups(2).Value.Trim()&#xA;    dados(&quot;ParcelaValor&quot;) = m.Groups(4).Value.Trim()&#xA;End If&#xA;&#xA;' ---------- 14) Normalizar o Edital (tirar quebras e espacos duplos) ----------&#xA;If dados.ContainsKey(&quot;Edital&quot;) Then&#xA;    dados(&quot;Edital&quot;) = System.Text.RegularExpressions.Regex.Replace(dados(&quot;Edital&quot;).ToString, &quot;\s+&quot;, &quot; &quot;).Trim()&#xA;End If&#xA;&#xA;' ---------- 16) Objeto da Garantia (1o paragrafo) ----------&#xA;m = System.Text.RegularExpressions.Regex.Match(texto, &quot;Objeto\s+da\s+Garantia\s+([\s\S]*?)(?=\r?\n[ \t]*\r?\n)&quot;)&#xA;If m.Success Then&#xA;    dados(&quot;ObjetoGarantia&quot;) = System.Text.RegularExpressions.Regex.Replace(m.Groups(1).Value, &quot;\s+&quot;, &quot; &quot;).Replace(&quot;;&quot;, &quot;,&quot;).Trim()&#xA;End If&#xA;' ---------- Diagnostico ----------&#xA;rx = &quot;Campos encontrados: &quot; &amp; dados.Count.ToString" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="416,403" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
