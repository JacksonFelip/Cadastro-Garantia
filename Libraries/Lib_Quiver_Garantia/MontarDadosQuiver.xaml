    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim F As New System.Globalization.CultureInfo(&quot;pt-BR&quot;)&#xA;Dim inv As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xA;&#xA;' ---- objetos do JSON ----&#xA;Dim tom  = TryCast(apolice(&quot;policyholder&quot;), Newtonsoft.Json.Linq.JObject)&#xA;Dim seg  = TryCast(apolice(&quot;insuredOrTribunal&quot;), Newtonsoft.Json.Linq.JObject)&#xA;Dim moda = TryCast(apolice(&quot;modality&quot;), Newtonsoft.Json.Linq.JObject)&#xA;Dim inst = TryCast(apolice(&quot;installments&quot;), Newtonsoft.Json.Linq.JArray)&#xA;Dim brk  = TryCast(apolice(&quot;insuranceBrokersPartner&quot;), Newtonsoft.Json.Linq.JArray)&#xA;&#xA;' ---- Sub-tipo: Licitante -&gt; Avulsa | demais -&gt; Renovavel ----&#xA;Dim modal = If(moda Is Nothing, &quot;&quot;, moda(&quot;description&quot;).ToString)&#xA;Dim subTipo = If(modal.ToUpper().Contains(&quot;LICITANTE&quot;), &quot;Avulsa&quot;, &quot;Renovavel&quot;)&#xA;&#xA;' ---- datas (ISO -&gt; dd/MM/yyyy) ----&#xA;Dim ini = &quot;&quot;, fim = &quot;&quot;, emi = &quot;&quot;, ven = &quot;&quot;&#xA;If apolice(&quot;durationStart&quot;) IsNot Nothing Then ini = DateTime.Parse(apolice(&quot;durationStart&quot;).ToString, inv).ToString(&quot;dd/MM/yyyy&quot;)&#xA;If apolice(&quot;durationEnd&quot;)   IsNot Nothing Then fim = DateTime.Parse(apolice(&quot;durationEnd&quot;).ToString, inv).ToString(&quot;dd/MM/yyyy&quot;)&#xA;If apolice(&quot;issueAt&quot;)       IsNot Nothing Then emi = DateTime.Parse(apolice(&quot;issueAt&quot;).ToString, inv).ToString(&quot;dd/MM/yyyy&quot;)&#xA;&#xA;Dim qtd As String = &quot;1&quot;&#xA;If inst IsNot Nothing AndAlso inst.Count &gt; 0 Then&#xA;    qtd = inst.Count.ToString&#xA;    If inst(0)(&quot;dueDate&quot;) IsNot Nothing Then ven = DateTime.Parse(inst(0)(&quot;dueDate&quot;).ToString, inv).ToString(&quot;dd/MM/yyyy&quot;)&#xA;End If&#xA;&#xA;' ---- valores ----&#xA;Dim isv = CDbl(apolice(&quot;insuredAmount&quot;)).ToString(&quot;N2&quot;, F)&#xA;Dim pl  = CDbl(apolice(&quot;netPremiumValue&quot;)).ToString(&quot;N2&quot;, F)&#xA;Dim pt  = CDbl(apolice(&quot;totalPremiumValue&quot;)).ToString(&quot;N2&quot;, F)&#xA;Dim iof = (CDbl(apolice(&quot;totalPremiumValue&quot;)) - CDbl(apolice(&quot;netPremiumValue&quot;))).ToString(&quot;N2&quot;, F)&#xA;&#xA;' ---- comissao da API (com fallback) ----&#xA;Dim com As String = &quot;32,0000&quot;&#xA;If brk IsNot Nothing AndAlso brk.Count &gt; 0 Then&#xA;    com = CDbl(brk(0)(&quot;commissionPercentage&quot;)).ToString(&quot;N4&quot;, F)&#xA;End If&#xA;&#xA;' ---- do PDF ----&#xA;Dim objeto  = If(dados.ContainsKey(&quot;ObjetoGarantia&quot;), dados(&quot;ObjetoGarantia&quot;).ToString, &quot;&quot;)&#xA;Dim produto = If(dados.ContainsKey(&quot;RamoDescricao&quot;),  dados(&quot;RamoDescricao&quot;).ToString,  &quot;&quot;)&#xA;&#xA;' ---- monta a linha (21 colunas) ----&#xA;linha = String.Join(&quot;;&quot;, New String() {&#xA;    If(tom Is Nothing, &quot;&quot;, tom(&quot;name&quot;).ToString),                    ' 1  Cliente/Tomador (API)&#xA;&#x9;If(dados.ContainsKey(&quot;CnpjTomador&quot;), dados(&quot;CnpjTomador&quot;).ToString, &quot;&quot;),&#xA;    apolice(&quot;policyNumber&quot;).ToString.Replace(&quot;-&quot;,&quot;&quot;),                 ' 2  Nº apolice&#xA;    subTipo,                                                          ' 3  Sub-tipo&#xA;    &quot;JUNTO SEGUROS&quot;,                                                  ' 4  Seguradora&#xA;    produto,                                                          ' 5  Produto (PDF)&#xA;    &quot;JGS GARANTIA&quot;,                                                   ' 6  Grupo producao&#xA;    If(apolice(&quot;documentNumber&quot;) Is Nothing, &quot;&quot;, apolice(&quot;documentNumber&quot;).ToString), ' 7&#xA;    ini,                                                              ' 8  Inicio vigencia (API)&#xA;    fim,                                                              ' 9  Termino vigencia (API)&#xA;    emi,                                                              ' 10 Data emissao (API)&#xA;    &quot;Seguro Novo&quot;,                                                    ' 11 Tipo negocio&#xA;    If(seg Is Nothing, &quot;&quot;, seg(&quot;name&quot;).ToString),                     ' 12 Segurado (API!)&#xA;    &quot;&quot;,                                                               ' 13 Endereco local risco (nao obrigatorio)&#xA;    &quot;&quot;,                                                               ' 14 Edital (nao obrigatorio)&#xA;    objeto,                                                           ' 15 Objeto do seguro (PDF)&#xA;    isv,                                                              ' 16 IS (API)&#xA;    com,                                                              ' 17 Comissao (API)&#xA;    pl,                                                               ' 18 Premio liq (API)&#xA;    iof,                                                              ' 19 IOF (API)&#xA;    qtd,                                                              ' 20 Qtd parcelas (API)&#xA;    ven                                                               ' 21 Venc 1a parcela (API)&#xA;})" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="450,394" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
